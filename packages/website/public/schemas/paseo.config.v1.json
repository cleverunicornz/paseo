{
  "$ref": "#/definitions/PaseoConfigV1",
  "definitions": {
    "PaseoConfigV1": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "daemon": {
          "type": "object",
          "properties": {
            "listen": {
              "type": "string"
            },
            "hostnames": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "allowedHosts": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "trustedProxies": {
              "description": "Express trusted proxy setting for X-Forwarded-* headers. Defaults to [\"loopback\"]. Use true only when the final trusted proxy overwrites client-supplied forwarded headers.",
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "injectIntoAgents": {
                  "type": "boolean"
                },
                "gateway": {
                  "type": "object",
                  "properties": {
                    "backends": {
                      "type": "object",
                      "description": "Named backends agents reach through the daemon at /mcp/backends/<name>: a URL, or an object with the URL and how long to wait for the backend's response headers.",
                      "propertyNames": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "additionalProperties": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:\\[(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|::(?:[0-9A-Fa-f]{1,4}:){5}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::)\\]|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9](?:-?[A-Za-z0-9])*\\.)*[A-Za-z](?:-?[A-Za-z0-9])*)(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})|[/?])*)?$"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "url": {
                                "type": "string",
                                "format": "uri",
                                "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://(?:\\[(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|::(?:[0-9A-Fa-f]{1,4}:){5}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){4}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,1}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){3}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,2}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:){2}(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,3}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}:(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,4}[0-9A-Fa-f]{1,4})?::(?:[0-9A-Fa-f]{1,4}:[0-9A-Fa-f]{1,4}|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))|(?:(?:[0-9A-Fa-f]{1,4}:){0,5}[0-9A-Fa-f]{1,4})?::[0-9A-Fa-f]{1,4}|(?:(?:[0-9A-Fa-f]{1,4}:){0,6}[0-9A-Fa-f]{1,4})?::)\\]|(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|(?:[A-Za-z0-9](?:-?[A-Za-z0-9])*\\.)*[A-Za-z](?:-?[A-Za-z0-9])*)(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))?(?:/(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:(?:[A-Za-z0-9._~!$&'()*+,;=:@-]|%[0-9A-Fa-f]{2})|[/?])*)?$"
                              },
                              "responseTimeoutMs": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 3600000,
                                "description": "Milliseconds to wait for the backend's response headers. Defaults to 30000; streams are not limited once they start."
                              }
                            },
                            "required": ["url"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "modelBackends": {
                      "type": "object",
                      "description": "The gateway backend each provider's model traffic goes to, by provider id. A harness of a named provider calls the daemon's gateway with its per-agent token, which is valid only at its own daemon; provider credentials are never inherited.",
                      "propertyNames": {
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      }
                    },
                    "envPassthrough": {
                      "type": "array",
                      "description": "Trusted configuration: variables a gateway-enabled harness inherits from the daemon's environment beyond the base variables, as names or NAME_* prefixes. Names carrying provider credentials, selecting a provider or cloud credentials, setting a proxy, steering the loader or Node runtime, or relocating harness configuration are refused.",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\*?$",
                        "not": {
                          "pattern": "^(?:[Aa][Nn][Tt][Hh][Rr][Oo][Pp][Ii][Cc]_|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Dd][Ee]_[Uu][Ss][Ee]_|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Dd][Ee]_[Ss][Kk][Ii][Pp]_|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Dd][Ee]_[Oo][Aa][Uu][Tt][Hh]_|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Dd][Ee]_[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Dd][Ee]_[Cc][Ll][Ii][Ee][Nn][Tt]_|[Oo][Pp][Ee][Nn][Aa][Ii]_|[Cc][Oo][Dd][Ee][Xx]_[Aa][Pp][Ii]_[Kk][Ee][Yy]|[Aa][Ww][Ss]_|[Aa][Zz][Uu][Rr][Ee]_|[Gg][Oo][Oo][Gg][Ll][Ee]_|[Gg][Cc][Ll][Oo][Uu][Dd]_|[Cc][Ll][Oo][Uu][Dd][Ss][Dd][Kk]_|[Cc][Ll][Oo][Uu][Dd]_[Mm][Ll]_|[Vv][Ee][Rr][Tt][Ee][Xx]_|[Hh][Tt][Tt][Pp]_[Pp][Rr][Oo][Xx][Yy]|[Hh][Tt][Tt][Pp][Ss]_[Pp][Rr][Oo][Xx][Yy]|[Aa][Ll][Ll]_[Pp][Rr][Oo][Xx][Yy]|[Nn][Oo]_[Pp][Rr][Oo][Xx][Yy]|[Ff][Tt][Pp]_[Pp][Rr][Oo][Xx][Yy]|[Ll][Dd]_|[Dd][Yy][Ll][Dd]_|[Nn][Oo][Dd][Ee]_[Oo][Pp][Tt][Ii][Oo][Nn][Ss]|[Nn][Oo][Dd][Ee]_[Ee][Xx][Tt][Rr][Aa]_[Cc][Aa]_[Cc][Ee][Rr][Tt][Ss]|[Ss][Ss][Ll]_[Cc][Ee][Rr][Tt]_[Ff][Ii][Ll][Ee]|[Ss][Ss][Ll]_[Cc][Ee][Rr][Tt]_[Dd][Ii][Rr]|[Cc][Ll][Aa][Uu][Dd][Ee]_[Cc][Oo][Nn][Ff][Ii][Gg]_[Dd][Ii][Rr]|[Cc][Oo][Dd][Ee][Xx]_[Hh][Oo][Mm][Ee])[A-Za-z0-9_]*\\*?$|^(?:[Aa](?:[Nn](?:[Tt](?:[Hh](?:[Rr](?:[Oo](?:[Pp](?:[Ii](?:[Cc](?:_)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Uu](?:[Ss](?:[Ee](?:_)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Ss](?:[Kk](?:[Ii](?:[Pp](?:_)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Oo](?:[Aa](?:[Uu](?:[Tt](?:[Hh](?:_)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Aa](?:[Pp](?:[Ii](?:_(?:[Kk](?:[Ee](?:[Yy])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Ll](?:[Ii](?:[Ee](?:[Nn](?:[Tt](?:_)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Oo](?:[Pp](?:[Ee](?:[Nn](?:[Aa](?:[Ii](?:_)?)?)?)?)?)?|[Cc](?:[Oo](?:[Dd](?:[Ee](?:[Xx](?:_(?:[Aa](?:[Pp](?:[Ii](?:_(?:[Kk](?:[Ee](?:[Yy])?)?)?)?)?)?)?)?)?)?)?)?|[Aa](?:[Ww](?:[Ss](?:_)?)?)?|[Aa](?:[Zz](?:[Uu](?:[Rr](?:[Ee](?:_)?)?)?)?)?|[Gg](?:[Oo](?:[Oo](?:[Gg](?:[Ll](?:[Ee](?:_)?)?)?)?)?)?|[Gg](?:[Cc](?:[Ll](?:[Oo](?:[Uu](?:[Dd](?:_)?)?)?)?)?)?|[Cc](?:[Ll](?:[Oo](?:[Uu](?:[Dd](?:[Ss](?:[Dd](?:[Kk](?:_)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Oo](?:[Uu](?:[Dd](?:_(?:[Mm](?:[Ll](?:_)?)?)?)?)?)?)?)?|[Vv](?:[Ee](?:[Rr](?:[Tt](?:[Ee](?:[Xx](?:_)?)?)?)?)?)?|[Hh](?:[Tt](?:[Tt](?:[Pp](?:_(?:[Pp](?:[Rr](?:[Oo](?:[Xx](?:[Yy])?)?)?)?)?)?)?)?)?|[Hh](?:[Tt](?:[Tt](?:[Pp](?:[Ss](?:_(?:[Pp](?:[Rr](?:[Oo](?:[Xx](?:[Yy])?)?)?)?)?)?)?)?)?)?|[Aa](?:[Ll](?:[Ll](?:_(?:[Pp](?:[Rr](?:[Oo](?:[Xx](?:[Yy])?)?)?)?)?)?)?)?|[Nn](?:[Oo](?:_(?:[Pp](?:[Rr](?:[Oo](?:[Xx](?:[Yy])?)?)?)?)?)?)?|[Ff](?:[Tt](?:[Pp](?:_(?:[Pp](?:[Rr](?:[Oo](?:[Xx](?:[Yy])?)?)?)?)?)?)?)?|[Ll](?:[Dd](?:_)?)?|[Dd](?:[Yy](?:[Ll](?:[Dd](?:_)?)?)?)?|[Nn](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Oo](?:[Pp](?:[Tt](?:[Ii](?:[Oo](?:[Nn](?:[Ss])?)?)?)?)?)?)?)?)?)?)?|[Nn](?:[Oo](?:[Dd](?:[Ee](?:_(?:[Ee](?:[Xx](?:[Tt](?:[Rr](?:[Aa](?:_(?:[Cc](?:[Aa](?:_(?:[Cc](?:[Ee](?:[Rr](?:[Tt](?:[Ss])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Ss](?:[Ss](?:[Ll](?:_(?:[Cc](?:[Ee](?:[Rr](?:[Tt](?:_(?:[Ff](?:[Ii](?:[Ll](?:[Ee])?)?)?)?)?)?)?)?)?)?)?)?|[Ss](?:[Ss](?:[Ll](?:_(?:[Cc](?:[Ee](?:[Rr](?:[Tt](?:_(?:[Dd](?:[Ii](?:[Rr])?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Ll](?:[Aa](?:[Uu](?:[Dd](?:[Ee](?:_(?:[Cc](?:[Oo](?:[Nn](?:[Ff](?:[Ii](?:[Gg](?:_(?:[Dd](?:[Ii](?:[Rr])?)?)?)?)?)?)?)?)?)?)?)?)?)?)?)?|[Cc](?:[Oo](?:[Dd](?:[Ee](?:[Xx](?:_(?:[Hh](?:[Oo](?:[Mm](?:[Ee])?)?)?)?)?)?)?)?)?)\\*$|^[A-Za-z0-9_]*_[Pp][Rr][Oo][Xx][Yy]$|^[A-Za-z0-9_]*_[Pp][Rr][Oo][Xx][Yy][A-Za-z0-9_]*\\*$"
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "localTools": {
                  "type": "object",
                  "description": "The Codex executable the daemon runs, with no model and no login, as the executor of the agents' local tools (exec, files, patches, processes, search, git) on /mcp/agents. Absent, the local tools are off. PASEO_LOCAL_TOOLS_CODEX_PATH replaces codexPath.",
                  "properties": {
                    "codexPath": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Absolute path of the Codex executable."
                    },
                    "codexHome": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The executor's own Codex home. Defaults to $PASEO_HOME/local-tools/codex-home."
                    }
                  },
                  "required": ["codexPath"],
                  "additionalProperties": false
                },
                "toolTree": {
                  "type": "object",
                  "description": "A per-agent directory of TypeScript files, one per tool the agent is rendered (Paseo's and every MCP backend's), that the agent's code can import and call. Its harness gets the location as PASEO_TOOL_TREE.",
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "dir": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Parent directory of the per-agent trees. Defaults to $PASEO_HOME/tool-trees."
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            },
            "git": {
              "type": "object",
              "properties": {
                "maxProcessesPerSecond": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "maxProcessConcurrency": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "autoArchiveAfterMerge": {
              "type": "boolean"
            },
            "enableTerminalAgentHooks": {
              "type": "boolean"
            },
            "appendSystemPrompt": {
              "type": "string"
            },
            "cors": {
              "type": "object",
              "properties": {
                "allowedOrigins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "relay": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "endpoint": {
                  "type": "string"
                },
                "publicEndpoint": {
                  "type": "string"
                },
                "useTls": {
                  "type": "boolean"
                },
                "publicUseTls": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "serviceProxy": {
              "type": "object",
              "properties": {
                "enabled": {
                  "description": "Compatibility shim. false suppresses optional service proxy listen/public layers only; localhost proxying remains enabled.",
                  "type": "boolean"
                },
                "listen": {
                  "description": "Optional service-only listener address. Presence enables the standalone service proxy listener.",
                  "type": "string"
                },
                "publicBaseUrl": {
                  "description": "Optional public base URL for service host aliases.",
                  "type": "string",
                  "format": "uri"
                }
              },
              "additionalProperties": false
            },
            "auth": {
              "type": "object",
              "properties": {
                "password": {
                  "type": "string",
                  "pattern": "^\\$2[aby]\\$\\d{2}\\$[./A-Za-z0-9]{53}$"
                }
              },
              "additionalProperties": false
            },
            "shutdown": {
              "type": "object",
              "properties": {
                "timelineDrainMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 86400000
                }
              },
              "additionalProperties": false
            },
            "singleAgent": {
              "type": "boolean"
            },
            "web": {
              "type": "object",
              "properties": {
                "basePath": {
                  "type": "string",
                  "pattern": "^\\/(?:[A-Za-z0-9._~-]+\\/)*(?:[A-Za-z0-9._~-]+)?$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "app": {
          "type": "object",
          "properties": {
            "baseUrl": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
