{
  "$ref": "#/definitions/PaseoConfigV1",
  "definitions": {
    "PaseoConfigV1": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "daemon": {
          "type": "object",
          "properties": {
            "listen": {
              "type": "string"
            },
            "hostnames": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "allowedHosts": {
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "trustedProxies": {
              "description": "Express trusted proxy setting for X-Forwarded-* headers. Defaults to [\"loopback\"]. Use true only when the final trusted proxy overwrites client-supplied forwarded headers.",
              "anyOf": [
                {
                  "type": "boolean",
                  "const": true
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "mcp": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "injectIntoAgents": {
                  "type": "boolean"
                },
                "gateway": {
                  "type": "object",
                  "properties": {
                    "backends": {
                      "type": "object",
                      "description": "Named backends agents reach through the daemon at /mcp/backends/<name>: a URL, or an object with the URL and how long to wait for the backend's response headers.",
                      "propertyNames": {
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                      },
                      "additionalProperties": {
